    <!-- Presentation only; loader and media engagement remain owned by Pygbag 0.9.3. -->
    <style>
        body { background: #090D1B; color: #F8FAFC; font-family: system-ui, sans-serif; }
        #launch { position: fixed; inset: 0; z-index: 20; overflow: auto;
            display: grid; place-items: center; padding: 24px; box-sizing: border-box;
            background: radial-gradient(ellipse at 15% 15%, #7c3aed25, transparent 55%),
                radial-gradient(ellipse at 90% 90%, #22d3ee15, transparent 50%), #090D1B; }
        #launch[hidden] { display: none; }
        .launch-panel { width: min(100%, 700px); text-align: center;
            display: flex; flex-direction: column; align-items: center; padding: 24px 0; }
        .eyebrow { margin: 0 0 24px; color: #22D3EE; font: 700 12px monospace; letter-spacing: .3em; }
        h1 { font-size: clamp(40px, 9vw, 82px); line-height: 1.08; letter-spacing: -.05em;
            margin: 0 0 clamp(36px, 7vh, 64px); text-shadow: 0 0 55px #7C3AED55; }
        h1 span { color: #A78BFA; }
        #enter-arcade { border: 1px solid #A78BFA; border-radius: 8px; padding: 18px 38px;
            color: #F8FAFC; background: #7C3AED; font: 800 14px system-ui; letter-spacing: .16em;
            cursor: pointer; box-shadow: 0 0 32px #7C3AED40; }
        #enter-arcade:disabled { opacity: .4; cursor: wait; }
        #enter-arcade:not(:disabled):hover { background: #6530ca; }
        #enter-arcade:focus-visible, #launch a:focus-visible { outline: 3px solid #22D3EE; outline-offset: 5px; }
        .loading-track { width: 180px; height: 3px; margin: 24px auto 16px; overflow: hidden; background: #19213B; }
        .loading-track::after { content: ''; display: block; height: 100%; width: 40%; background: #22D3EE;
            animation: loading 1.4s ease-in-out infinite alternate; }
        #launch.ready .loading-track::after { animation: none; width: 100%; }
        #launch.failed .loading-track { display: none; }
        @keyframes loading { from { transform: translateX(-100%); } to { transform: translateX(350%); } }
        #infobox { position: static; background: none; color: #A5B4FC; padding: 0;
            font: 13px/1.6 system-ui; min-height: 42px; }
        .launch-help { margin: 28px 0 0; color: #A5B4FC; font-size: 11px; line-height: 1.8; }
        #launch a { color: #A5B4FC; }
        #transfer { position: fixed; bottom: 8px; left: 8px; z-index: 21; font-size: 11px; }
        #status { color: #A5B4FC; margin: 0; font-weight: normal; }
        #progress { height: 4px; width: 160px; accent-color: #22D3EE; }
        #pyconsole, #crt { position: relative; z-index: 30; }
        @media (prefers-reduced-motion: reduce) { .loading-track::after { animation: none; transform: none; } }
    </style>
    <section id="launch" aria-labelledby="launch-title">
        <div class="launch-panel">
            <p class="eyebrow">PLAYER ONE / WELCOME</p>
            <h1 id="launch-title">MINIGAME<br><span>ARCADE</span></h1>
            <button id="enter-arcade" type="button" disabled>ENTER ARCADE</button>
            <div class="loading-track" aria-hidden="true"></div>
            <div id="infobox" role="status" aria-live="polite">Loading runtime and game assets...</div>
            <p class="launch-help">Keyboard recommended · Audio enabled when you enter<br>
                Taking too long? <a href="#debug" onclick="location.hash='debug'; location.reload()">Open runtime diagnostics</a></p>
            <noscript>JavaScript is required to load the arcade.</noscript>
        </div>
    </section>
    <script>
        window.arcadeEntered = false;
        window.arcadeReady = () => {
            document.getElementById('launch').classList.add('ready');
            document.getElementById('infobox').textContent = 'All systems ready. Your next high score awaits.';
            document.getElementById('enter-arcade').disabled = false;
        };
        document.getElementById('enter-arcade').addEventListener('click', () => {
            // The trusted click bubbles to Pygbag's media handlers (including Safari).
            // Never set MM.UME ourselves: its real audio-unlock gate still applies.
            window.arcadeEntered = true;
            document.getElementById('infobox').textContent = 'Starting the arcade...';
        });
        window.arcadeStarted = () => {
            document.getElementById('launch').hidden = true;
            document.getElementById('canvas').focus();
        };
        window.arcadeFailed = () => {
            const launch = document.getElementById('launch');
            launch.hidden = false;
            launch.classList.add('failed');
            const message = document.getElementById('infobox');
            message.style.display = 'block';
            message.textContent = 'The arcade could not start. Open runtime diagnostics below or the browser console, then reload to retry.';
            document.getElementById('enter-arcade').disabled = true;
        };
        window.addEventListener('error', () => window.arcadeFailed());
        window.addEventListener('unhandledrejection', () => window.arcadeFailed());
    </script>

